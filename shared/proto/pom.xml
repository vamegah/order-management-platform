<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =====================================================================
         PARENT
         ===================================================================== -->
    <parent>
        <groupId>com.example.omp</groupId>
        <artifactId>order-management-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- =====================================================================
         MODULE COORDINATES
         ===================================================================== -->
    <artifactId>omp-shared-proto</artifactId>
    <name>OMP Shared Proto</name>
    <description>
        Protocol Buffer definitions for the platform's gRPC services.

        Source .proto files:
          - common/money.proto         (Money message, shared)
          - inventory/inventory.proto  (InventoryService)
          - payment/payment.proto      (PaymentService)

        At build time, the protobuf-maven-plugin generates Java classes from
        these files into target/generated-sources. The build-helper-maven-
        plugin adds those directories to the compile path.

        The resulting jar contains both the message classes and the gRPC
        service stubs (XxxServiceGrpc). Services that implement or call the
        gRPC services depend on this module.
    </description>

    <!-- =====================================================================
         DEPENDENCIES
         Only the runtime libraries required by the generated classes.
         Versions come from the parent's dependencyManagement
         (protobuf.version and grpc.version via grpc-bom).
         ===================================================================== -->
    <dependencies>

        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>

        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>

      
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.tomcat</groupId>
            <artifactId>annotations-api</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- ============================================================
                 protobuf-maven-plugin
                 ============================================================
                 Runs protoc (for message classes) and protoc-gen-grpc-java
                 (for service stubs) against files in src/main/proto.

                 The plugin configuration (protocArtifact, pluginArtifact,
                 and the OS classifier selection) is inherited from the
                 parent POM's <pluginManagement>. Only the executions are
                 specified here.

                 Protoc version: ${protobuf.version} (3.25.5)
                 grpc-java plugin version: ${grpc.version} (1.68.1)
                 OS classifier: ${os.detected.classifier}, resolved by the
                 os-maven-plugin extension declared in the parent POM.
                 ============================================================ -->
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <executions>

                    <!-- Generate Java message classes from .proto files. -->
                    <execution>
                        <id>generate-protobuf-messages</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <writeDescriptorSet>true</writeDescriptorSet>
                            <descriptorSetFileName>platform.protobin</descriptorSetFileName>
                            <includeDependenciesInDescriptorSet>true</includeDependenciesInDescriptorSet>
                            <attachDescriptorSet>true</attachDescriptorSet>
                            <!-- Default proto source root:
                                 src/main/proto.
                                 Output: target/generated-sources/protobuf/java. -->
                        </configuration>
                    </execution>

                    <!-- Generate gRPC service stubs (XxxServiceGrpc)
                         using the protoc-gen-grpc-java plugin. -->
                    <execution>
                        <id>generate-grpc-stubs</id>
                        <goals>
                            <goal>compile-custom</goal>
                        </goals>
                        <configuration>
                            <!-- Output:
                                 target/generated-sources/protobuf/grpc-java. -->
                        </configuration>
                    </execution>

                </executions>
            </plugin>

            <!-- ============================================================
                 build-helper-maven-plugin
                 ============================================================
                 Adds the two generated-source directories to the compile
                 path so maven-compiler-plugin picks up the .java files
                 emitted by protoc.

                 Without this plugin, the generated .java files would exist
                 on disk but wouldn't be compiled into the jar, and
                 consumers would see missing classes.
                 ============================================================ -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/protobuf/java</source>
                                <source>${project.build.directory}/generated-sources/protobuf/grpc-java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Generated-client wire compatibility and streaming descriptor tests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
