<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =====================================================================
         PARENT
         ===================================================================== -->
    <parent>
        <groupId>com.example.omp</groupId>
        <artifactId>order-management-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- =====================================================================
         MODULE COORDINATES
         ===================================================================== -->
    <artifactId>omp-shared-domain</artifactId>
    <name>OMP Shared Domain</name>
    <description>
        Domain value objects shared across business services.

        Contains:
          - Money        (amount + currency)
          - Email        (validated, normalized email)
          - PhoneNumber  (validated phone, loose format)

        Pure Java classes annotated with JPA and Bean Validation
        annotations. No Spring dependency.
    </description>

    <!-- =====================================================================
         DEPENDENCIES
         ===================================================================== -->
    <dependencies>

        <!-- JPA annotations (@Embeddable, @Column, @AttributeOverride). -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Bean Validation annotations (@NotBlank, @Pattern, @Size). -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <!-- =====================================================================
         BUILD
         JaCoCo enforces higher coverage (90%) than services (80%) because
         value objects have simple, easily-tested logic. Spotless runs
         globally from the parent.
         ===================================================================== -->
    <build>
        <plugins>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>