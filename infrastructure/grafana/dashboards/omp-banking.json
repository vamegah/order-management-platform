{
  "uid": "omp-banking",
  "title": "OMP Banking SOAP Boundary",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "omp",
    "banking"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "SOAP call rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(banking_soap_attempts_total[5m])) by (operation)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "SOAP latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum(rate(banking_soap_duration_seconds_bucket[5m])) by (le,operation))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Circuit state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "resilience4j_circuitbreaker_state{name=\"banking\"}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Retries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(banking_soap_retries_total[5m])) by (operation)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Rejected work",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(banking_soap_rejected_total[5m])) by (operation)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Available backend slots",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "banking_bulkhead_available"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "REST error rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"legacy-banking-adapter\",status=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM heap use",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_memory_used_bytes{application=\"legacy-banking-adapter\",area=\"heap\"}"
        }
      ]
    }
  ]
}
