{
  "realm": "omp",
  "enabled": true,
  "displayName": "Order Management Platform",
  "displayNameHtml": "<strong>Order Management Platform</strong>",

  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,

  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "refreshTokenMaxReuse": 0,
  "revokeRefreshToken": true,

  "passwordPolicy": "length(12)",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 10,

  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Regular customer who can place orders",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "admin",
        "description": "Administrator with elevated privileges",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "service",
        "description": "Service account used for machine-to-machine authentication",
        "composite": false,
        "clientRole": false
      }
    ]
  },

  "groups": [],

  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@omp.local",
      "firstName": "Alice",
      "lastName": "Customer",
      "credentials": [
        {
          "type": "password",
          "value": "alice-dev-password",
          "temporary": false
        }
      ],
      "realmRoles": ["customer"],
      "requiredActions": [],
      "attributes": {
        "customer_id": ["00000000-0000-0000-0000-000000000101"],
        "orders_limit": ["1000"]
      }
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@omp.local",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin-dev-password",
          "temporary": false
        }
      ],
      "realmRoles": ["customer", "admin"],
      "requiredActions": [],
      "attributes": {
        "orders_limit": ["100000"]
      }
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@omp.local",
      "firstName": "Bob",
      "lastName": "Customer",
      "credentials": [
        {
          "type": "password",
          "value": "bob-dev-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ],
      "requiredActions": [],
      "attributes": {
        "customer_id": [
          "00000000-0000-0000-0000-000000000102"
        ],
        "orders_limit": [
          "1000"
        ]
      }
    }
  ],

  "clients": [
    {
      "clientId": "order-recovery",
      "name": "Development order recovery workload",
      "description": "Development-only client credentials; provision production workload credentials separately",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "secret": "dev-only-order-recovery-secret",
      "defaultClientScopes": ["basic", "order.reconcile"],
      "optionalClientScopes": []
    },
    {
      "clientId": "order-service",
      "name": "Order Service",
      "description": "Backend service managing orders",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "secret": "dev-only-order-service-secret",
      "defaultClientScopes": ["basic", "web-origins", "profile", "roles", "email", "orders"],
      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "customer-service",
      "name": "Customer Service",
      "description": "Backend service managing customer profiles",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "secret": "dev-only-customer-service-secret",
      "defaultClientScopes": ["basic", "web-origins", "profile", "roles", "email", "orders"],
      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "product-service",
      "name": "Product Service",
      "description": "Backend service managing the product catalog",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "secret": "dev-only-product-service-secret",
      "defaultClientScopes": ["basic", "web-origins", "profile", "roles", "email", "orders"],
      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "web-app",
      "name": "Web Application",
      "description": "Browser-based front-end application",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://localhost:3000/*",
        "http://web.localhost/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://web.localhost"
      ],
      "defaultClientScopes": ["basic", "web-origins", "profile", "roles", "email", "orders"],
      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "postman",
      "name": "Postman (developer tool)",
      "description": "OAuth2 client for manual API testing via Postman",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "https://oauth.pstmn.io/v1/callback",
        "http://localhost:*"
      ],
      "webOrigins": ["*"],
      "defaultClientScopes": ["basic", "web-origins", "profile", "roles", "email", "orders"],
      "optionalClientScopes": ["offline_access"]
    }
  ],

  "clientScopes": [
    {
      "name": "order.reconcile",
      "description": "Privileged order recovery discovery and compensation",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "inventory recovery audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "inventory-service", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "payment recovery audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "payment-service", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "name": "basic",
      "protocol": "openid-connect",
      "description": "Stable subject identity required by resource servers and STOMP",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience resolve",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-resolve-mapper",
          "config": {}
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "web-origins",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "allowed web origins",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-allowed-origins-mapper",
          "config": { "access.token.claim": "true" }
        }
      ]
    },
    {
      "name": "orders",
      "description": "Order-related custom claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "customer_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "customer_id",
            "claim.name": "customer_id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "orders_limit",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "orders_limit",
            "claim.name": "orders_limit",
            "jsonType.label": "long",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],

  "defaultDefaultClientScopes": [
    "basic",
    "profile",
    "email",
    "roles",
    "web-origins",
    "orders"
  ],

  "defaultOptionalClientScopes": [
    "offline_access"
  ],

  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xContentTypeOptions": "nosniff",
    "xFrameOptions": "SAMEORIGIN",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },

  "smtpServer": {},

  "eventsEnabled": false,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": [],
  "adminEventsEnabled": false,
  "adminEventsDetailsEnabled": false,

  "internationalizationEnabled": false,
  "supportedLocales": [],
  "defaultLocale": "en",

  "registrationEmailAsUsername": false,
  "loginTheme": "",
  "accountTheme": "",
  "adminTheme": "",
  "emailTheme": ""
}
