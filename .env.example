# ==============================================================================
# Order Management Platform — Local Development Environment Template
# ------------------------------------------------------------------------------
# USAGE
#   cp .env.example .env
#   # edit .env — set real values (or accept the localhost-safe defaults below)
#   docker compose up -d
#
# IMPORTANT
#   - This file is COMMITTED to git. Never put real secrets here.
#   - The `.env` file you create from this template is GITIGNORED.
#   - All values below are safe for LOCAL development only.
#   - Production values live in `.env.prod` (see .env.prod.example).
#
# CONVENTIONS
#   - No quotes around values. Docker Compose reads this file as a shell-style
#     env file, but quoted strings can surprise you across shells. Keep it plain.
#   - No spaces around `=`. `FOO = bar` is not the same as `FOO=bar`.
#   - Comments use `#`. Trailing comments on the same line as a value work,
#     but avoid them for passwords that might contain `#`.
#   - If a value must contain special characters ($, #, spaces), it's noted
#     in the comment. When in doubt, prefer alphanumeric + `-_.`.
#
# SPECIAL CHARACTERS
#   - Dollar sign (`$`): MUST be escaped as `$$` in this file. Compose
#     interprets `$` as a variable reference, so a literal `$2y$...` becomes
#     `y...` after substitution (with warnings). Write `$$2y$$...` for the
#     value to arrive intact. The escaping is required for any value with
#     `$` — most commonly bcrypt hashes (TRAEFIK_ADMIN_BASICAUTH in
#     .env.prod.example).
#   - Hash (`#`): if a value contains `#`, wrap the whole line in quotes:
#     `FOO="val#ue"`. But avoid `#` in values when possible; the parsing
#     varies across compose versions.
#   - Quotes: prefer no quotes. If a value has spaces, quote it:
#     `FOO="hello world"`. Spaces in passwords are a bug magnet — regenerate.
# ==============================================================================

# ------------------------------------------------------------------------------
# COMPOSE PROJECT
# ------------------------------------------------------------------------------
# Not read by docker-compose.yml directly (the base file hardcodes `name: omp`),
# but some tooling (Makefiles, scripts) reads this for consistency.
COMPOSE_PROJECT_NAME=omp

# ------------------------------------------------------------------------------
# POSTGRESQL
# ------------------------------------------------------------------------------
# One instance, one database (`omp`), one schema per service. The superuser
# owns the database; per-service roles are created by init scripts (File 6).
#
# LOCAL DEV VALUES
#   - DB name: `omp` (matches the service name in compose)
#   - Superuser: `omp_admin` (NOT `postgres` — that's the default superuser
#     name the official image creates if you don't override, and we want a
#     named role so audit logs are meaningful)
#   - Password: pick anything for localhost; it's not exposed to the internet
# ------------------------------------------------------------------------------
POSTGRES_DB=omp
POSTGRES_SUPERUSER=omp_admin
POSTGRES_SUPERPASSWORD=local-dev-only-change-me

# Host port to expose Postgres on. Change if 5432 is already in use
# (common on macOS with Postgres.app, or if you have another Docker project).
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# PGDADMIN (dev only)
# ------------------------------------------------------------------------------
# Web UI for browsing Postgres. Not deployed in production.
# The email just needs to be a valid email format; no mail is sent.
# ------------------------------------------------------------------------------
PGADMIN_EMAIL=admin@omp.local
PGADMIN_PASSWORD=local-dev-only-change-me

# --- Batch 9.3: notification-service database ---
NOTIFICATION_SERVICE_DB_USER=notifications_svc
NOTIFICATION_SERVICE_DB_PASSWORD=local-dev-notifications-password

# ------------------------------------------------------------------------------
# REDIS
# ------------------------------------------------------------------------------
# Used for cache, WebSocket pub/sub, and rate-limit counters (Phases 1, 4, 7).
#
# LOCAL DEV VALUE
#   - Password: must be NON-EMPTY. The compose file requires it (no default
#     for empty), and the healthcheck uses it. Use a simple string locally.
#   - In production, this becomes a Docker secret (File 2b).
# ------------------------------------------------------------------------------
REDIS_PASSWORD=local-dev-redis-password

# Host port to expose Redis on. Change if 6379 is in use.
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# KAFKA
# ------------------------------------------------------------------------------
# Single-broker KRaft (no Zookeeper) for local dev. The internal listener is
# always `kafka:9092` (used by containers); the external listener is exposed
# on the host so Maven tests and CLI tools can connect.
#
# Note: Kafka has no password in dev (PLAINTEXT). Production overlay adds
# SASL/SCRAM (File 2b).
# ------------------------------------------------------------------------------
# Host port for the EXTERNAL listener. Must match what your Maven tests use.
# If you change this, also update `src/test/resources/application-test.yml`
# in any service that produces or consumes Kafka events.
KAFKA_EXTERNAL_PORT=29092

# ------------------------------------------------------------------------------
# KEYCLOAK
# ------------------------------------------------------------------------------
# OAuth2/OIDC identity provider. In dev, `start-dev` mode is used, meaning:
#   - HTTP (no TLS), relaxed hostname checks
#   - Admin console at http://keycloak.localhost
#   - Realm `omp` is imported from infrastructure/keycloak/import/ (File 12)
#
# LOCAL DEV VALUES
#   - Admin user: `admin` (Keycloak's convention; fine for local)
#   - Admin password: pick anything; this account controls your local realm
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-only-change-me


# --- Batch 9.4: payment-service ---
PAYMENT_SERVICE_DB_USER=payments_svc
PAYMENT_SERVICE_DB_PASSWORD=local-dev-payments-password
PAYMENT_PROVIDER=noop
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PAYMENT PROVIDER SIMULATOR (Phase 5) ---
# Simulates an external payment provider for local dev and e2e testing.
# SIMULATOR_WEBHOOK_SECRET must match payment-service's inbound webhook secret.
SIMULATOR_PORT=8090
SIMULATOR_WEBHOOK_SECRET=dev-simulator-secret-not-for-production
SIMULATOR_WEBHOOK_DELAY_MS=2000
SIMULATOR_FAILURE_RATE=0.0

# --- LEGACY BANKING ADAPTER (Phase 6) ---
# REST-to-SOAP bridge for the legacy bank service.
BANK_PASSWORD=platform-secret

# --- ALERTMANAGER (Phase 7) ---
# Webhook URL for alert delivery in dev. Replace with Slack/PagerDuty in prod.
ALERTMANAGER_WEBHOOK_URL=http://localhost:5001/alerts

# ------------------------------------------------------------------------------
# PROMETHEUS
# ------------------------------------------------------------------------------
# Metrics backend. Scrapes /metrics endpoints from every instrumented
# service (Traefik, OTel Collector, Keycloak; business services from Phase
# 1+).
#
# LOCAL DEV VALUE
#   - PROMETHEUS_ENV: applied as an external label to every metric, so a
#     single Grafana instance can query `{env="dev"}` or `{env="prod"}` to
#     filter metrics by environment.
#   - Dev uses `dev`; the production overlay (File 2b) overrides with
#     `prod` via `.env.prod`.
#
# WHY THIS IS AN ENV VAR, NOT HARDCODED
#   The value flows: .env → docker-compose.yml → container environment →
#   prometheus.yml's ${PROMETHEUS_ENV} substitution → external label.
#   This makes the same prometheus.yml file usable in both dev and prod
#   without editing, matching our two-file overlay strategy.
# ------------------------------------------------------------------------------
PROMETHEUS_ENV=dev

# ------------------------------------------------------------------------------
# GRAFANA
# ------------------------------------------------------------------------------
# Dashboards for metrics (Prometheus), logs (Loki), traces (Tempo).
#
# LOCAL DEV VALUES
#   - Admin user: `admin` (Grafana's convention)
#   - Admin password: any non-empty string
#   - In production, this comes from a Docker secret (File 2b)
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-dev-only-change-me

# ------------------------------------------------------------------------------
# TRAEFIK (reverse proxy / ingress)
# ------------------------------------------------------------------------------
# Dev mode: HTTP only, no TLS, dashboard exposed on a dedicated port.
# All UI services are routed via `*.localhost` hostnames (no /etc/hosts edit
# needed — modern browsers resolve *.localhost to 127.0.0.1 automatically).
#
# Change these only if you have a conflict:
#   - Port 80 is often taken by Apache/Nginx on developer machines
#   - Port 8080 is often taken by other Java apps
# ------------------------------------------------------------------------------
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# ------------------------------------------------------------------------------
# OPEN TELEMETRY COLLECTOR
# ------------------------------------------------------------------------------
# The collector receives OTLP from services and fans out to Prometheus (metrics),
# Tempo (traces), and Loki (logs).
#
# Two ports:
#   - 4317: OTLP over gRPC (preferred; used by Java services)
#   - 4318: OTLP over HTTP (fallback; used by Traefik and some libs)
#
# Change only if these ports are already in use on your host.
# ------------------------------------------------------------------------------
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# ------------------------------------------------------------------------------
# APPLICATION SERVICES (added in later phases)
# ------------------------------------------------------------------------------
# The variables below are placeholders for phases 1+. They're documented here
# so the `.env` file is stable across the project's evolution, and so nobody
# has to guess what's expected when a new service lands.
#
# Uncomment and set values as each service is added.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# APPLICATION SERVICES
# ------------------------------------------------------------------------------
# Business services that run on the platform. Each has its own schema in
# Postgres, its own service role, and its own container in the compose stack.
#
# These variables are referenced by docker-compose.yml (the service block for
# each application service) and by the service's own application.yml.
# ------------------------------------------------------------------------------

# --- PRODUCT SERVICE (Phase 1) ---
# REST API for the product catalog. Owns the `products` schema.
PRODUCT_SERVICE_DB_USER=products_svc
PRODUCT_SERVICE_DB_PASSWORD=local-dev-products-password

# --- CUSTOMER SERVICE (Phase 1) ---
# REST API for customer profiles. Owns the `customers` schema.
CUSTOMER_SERVICE_DB_USER=customers_svc
CUSTOMER_SERVICE_DB_PASSWORD=local-dev-customers-password

# --- ORDER SERVICE (Phase 1) ---
# REST API for order management. Owns the `orders` schema.
ORDER_SERVICE_DB_USER=orders_svc
ORDER_SERVICE_DB_PASSWORD=local-dev-orders-password

# --- INVENTORY SERVICE (Phase 3) ---
# gRPC-only service for stock levels and reservations.
# No HTTP API. gRPC on port 9091, management HTTP on 9092 (internal only).
# Owns the `inventory` schema.
INVENTORY_SERVICE_DB_USER=inventory_svc
INVENTORY_SERVICE_DB_PASSWORD=local-dev-inventory-password

# --- PAYMENT SERVICE (Phase 3) ---
# gRPC-only service for payment intents and refunds.
# gRPC on port 9093, management HTTP on 9094 (internal only).
# Owns the `payments` schema.
PAYMENT_SERVICE_DB_USER=payments_svc
PAYMENT_SERVICE_DB_PASSWORD=local-dev-payment-password

# --- GRAPHQL GATEWAY (Phase 2) ---
# No secrets, no DB. Configuration is entirely via env vars set in the
# prod overlay (docker-compose.prod.yml).
#
# Only replicas and memory are set here as defaults.
GRAPHQL_GATEWAY_REPLICAS=2
GRAPHQL_GATEWAY_MEMORY_LIMIT=1G


# ------------------------------------------------------------------------------
# gRPC AND TLS
# ------------------------------------------------------------------------------
# Configuration for internal gRPC communication and mTLS.
#
# Most of these have sensible defaults in the services' application.yml.
# They're listed here so you can override them without editing YAML.

# Enable or disable mTLS on internal gRPC calls.
#   - Dev: "true" — mTLS is used (certificates from infrastructure/tls/).
#   - Test: "false" — the test profile disables it for in-process gRPC.
#   - Prod: "true" — always enabled.
GRPC_MTLS_ENABLED=true

# gRPC negotiation type for clients. Values: TLS (mTLS) or PLAINTEXT.
# Overridden to PLAINTEXT in test profile.
GRPC_NEGOTIATION_TYPE=TLS

# Path to the TLS certificate files inside the container.
# Dev: mounted from infrastructure/tls/<service>/.
# Prod: mounted from /etc/omp/tls/<service>/.
TLS_CERT_PATH=/etc/tls/tls.crt
TLS_KEY_PATH=/etc/tls/tls.key
TLS_CA_PATH=/etc/tls/ca.crt

# --- PRODUCT SERVICE (Phase 1) ---
# PRODUCT_SERVICE_PORT=8083
# PRODUCT_SERVICE_DB_SCHEMA=products
# PRODUCT_SERVICE_DB_USER=products_svc
# PRODUCT_SERVICE_DB_PASSWORD=local-dev-products-password

# --- INVENTORY SERVICE (Phase 3, gRPC) ---
# INVENTORY_GRPC_PORT=9091

# --- PAYMENT SERVICE (Phase 3, gRPC) ---
# PAYMENT_GRPC_PORT=9093
# PAYMENT_PROVIDER_API_KEY=sk_test_replace_with_stripe_test_key
# PAYMENT_WEBHOOK_SECRET=whsec_local_dev_only

# --- NOTIFICATION SERVICE (Phase 4) ---
# Consumes Kafka events and pushes to WebSocket clients.
# Uses Redis for cross-replica pub/sub and the notifications PostgreSQL schema
# for outbound subscriptions, delivery history, retry and dead-letter state.
#
# Redis is shared with the platform's cache; no separate password.
# See the REDIS section above for REDIS_PASSWORD.

# --- API GATEWAY (Phase 7) ---
# API_GATEWAY_PORT=8000

# ------------------------------------------------------------------------------
# FEATURE FLAGS (optional, for later phases)
# ------------------------------------------------------------------------------
# Some services will read feature flags from environment variables. These are
# only examples; the actual flags are introduced when the services that read
# them are added.
# ------------------------------------------------------------------------------

# Enable verbose SQL logging in dev (never enable in prod — logs PII)
# SPRING_JPA_SHOW_SQL=true

# Enable Spring Boot devtools hot reload
# SPRING_DEVTOOLS_RESTART_ENABLED=true

# Enable WebSocket debug logging
# LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB_SOCKET=DEBUG

# ------------------------------------------------------------------------------
# NOTES FOR NEW CONTRIBUTORS
# ------------------------------------------------------------------------------
# 1. Do not commit `.env`. It's in .gitignore for a reason.
# 2. If you add a new service that needs a new env var:
#    a. Add it to `docker-compose.yml` with the `:?` syntax.
#    b. Add it here with a comment explaining its purpose.
#    c. Add it to `.env.prod.example` in the appropriate form (usually
#       pointing to a Docker secret).
# 3. If a var is optional (has a default in compose via `${VAR:-default}`),
#    still list it here — commented out — so it's discoverable.
# 4. Never put real credentials in this file, even "just for staging." Staging
#    is production-adjacent and leaks are how breaches start.
# 5. If a value contains `$`, escape it as `$$` (see SPECIAL CHARACTERS at
#    the top of this file). This applies to bcrypt hashes and any other
#    value with shell metacharacters.
# 6. After editing `.env`, run `docker compose config` to verify every
#    variable resolves as expected. Compose will error on any `${VAR:?}`
#    without a value, and print the fully-resolved config for inspection.
# ==============================================================================
