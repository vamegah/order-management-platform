<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =====================================================================
         PARENT
         ===================================================================== -->
    <parent>
        <groupId>com.example.omp</groupId>
        <artifactId>order-management-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- =====================================================================
         MODULE COORDINATES
         ===================================================================== -->
    <artifactId>payment-service</artifactId>
    <name>Payment Service</name>
    <description>
        gRPC-only service for payment intents, confirmations, cancellations,
        and refunds.

        No REST API. Exposes PaymentService over gRPC on port 9093.
        Management HTTP (actuator) on port 9094.

        Owns the `payments` schema in the shared Postgres instance.

        Publishes payment lifecycle events to Kafka (PAYMENT_INTENT_CREATED,
        PAYMENT_CONFIRMED, PAYMENT_CANCELLED, PAYMENT_FAILED,
        PAYMENT_REFUNDED, PAYMENT_PARTIALLY_REFUNDED).
    </description>

    <!-- =====================================================================
         DEPENDENCIES
         ===================================================================== -->
    <dependencies>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ================================================================
             Internal shared modules
             ================================================================ -->

        <!-- gRPC service stubs and messages. Provides PaymentServiceGrpc,
             Payment, Refund, and com.example.omp.proto.common.Money. -->
        <dependency>
            <groupId>com.example.omp</groupId>
            <artifactId>omp-shared-proto</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- The Java value object Money, used on the Payment and Refund
             entities. MoneyConverter bridges this to the proto Money
             message. -->
        <dependency>
            <groupId>com.example.omp</groupId>
            <artifactId>omp-shared-domain</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Kafka event base classes and payment event records. Provides
             KafkaEventPublisher, TransactionEventScheduler, and
             PaymentEvents.*. -->
        <dependency>
            <groupId>com.example.omp</groupId>
            <artifactId>omp-shared-events</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Note: omp-shared-web is not declared. This service has no REST
             endpoints. -->

        <!-- ================================================================
             Spring Boot starters
             ================================================================ -->

        <!-- Note: NO spring-boot-starter-web. gRPC runs on its own Netty
             server. Actuator brings its own management HTTP server. -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>


        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>  <!-- for WebClient -->
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-reactor</artifactId>
            <version>2.2.0</version>
        </dependency>

        <!-- ================================================================
             gRPC server
             ================================================================ -->

        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
        </dependency>

        <!-- ================================================================
             Kafka producer
             ================================================================ -->

        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>

        <!-- ================================================================
             Persistence — drivers and migrations
             ================================================================ -->

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ================================================================
             Observability
             ================================================================ -->

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>

        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

        <!-- ================================================================
             Test dependencies
             ================================================================ -->

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- gRPC in-process transport for testing servers and clients
             without a network. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- gRPC testing utilities: ServerInterceptor test harness,
             StreamRecorder, etc. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-testing</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Client-side starter (test only). Provides @GrpcClient
             injection so integration tests can call the running gRPC
             server through the framework path. -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-client-spring-boot-starter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Kafka test support: @EmbeddedKafka. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- =====================================================================
         BUILD
         ===================================================================== -->
    <build>
        <plugins>

            <!-- ============================================================
                 Spring Boot Maven Plugin — executable jar packaging
                 ============================================================ -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- ============================================================
                 Surefire — unit tests
                 ============================================================ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!-- ============================================================
                 Failsafe — integration tests
                 ============================================================ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>

            <!-- ============================================================
                 JaCoCo — 80% coverage enforcement
                 ============================================================
                 Excludes:
                   - PaymentServiceApplication (main class)
                   - config/**    (Spring configuration)
                   - events/**    (publisher + factory; framework glue
                                   verified by integration tests)
                 ============================================================ -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>com/example/omp/payment/PaymentServiceApplication.class</exclude>
                                <exclude>com/example/omp/payment/config/**</exclude>
                                <exclude>com/example/omp/payment/events/**</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
