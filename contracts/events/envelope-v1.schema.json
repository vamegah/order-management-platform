{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.omp.example/events/v1",
  "title": "OMP domain event envelope v1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "aggregateId",
    "occurredAt",
    "schemaVersion",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "schemaVersion": {
      "const": 1
    },
    "data": {
      "type": "object"
    },
    "traceparent": {
      "type": "string"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true,
  "$defs": {
    "order": {
      "title": "order payload v1",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "orderId",
        "customerId"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "customerId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z_]*$"
        },
        "orderNumber": {
          "type": "string"
        }
      }
    },
    "payment": {
      "title": "payment payload v1",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "paymentId",
        "customerId"
      ],
      "properties": {
        "paymentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "orderId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "customerId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z_]*$"
        },
        "amount": {
          "type": "string"
        },
        "amountMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        }
      }
    },
    "inventory": {
      "title": "inventory payload v1",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "reservationId",
        "sku"
      ],
      "properties": {
        "reservationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "orderId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "warehouseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sku": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "pattern": "^(ORDER_|order[.])"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/order"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "pattern": "^(PAYMENT_|payment[.])"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/payment"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "pattern": "^(RESERVATION_|inventory[.])"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/inventory"
          }
        }
      }
    }
  ]
}
