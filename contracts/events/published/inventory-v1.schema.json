{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.omp.example/events/inventory/v1",
  "title": "inventory payload v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "reservationId",
    "sku"
  ],
  "properties": {
    "reservationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "orderId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "warehouseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "sku": {
      "type": "string",
      "minLength": 1
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  }
}
