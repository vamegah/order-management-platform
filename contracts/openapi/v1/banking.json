{
  "components": {
    "schemas": {
      "BalanceResponse": {
        "properties": {
          "accountNumber": {
            "type": "string"
          },
          "balance": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProblemDetail": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "instance": {
            "format": "uri",
            "type": "string"
          },
          "properties": {
            "additionalProperties": {},
            "type": "object"
          },
          "status": {
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "TransferRequest": {
        "properties": {
          "amount": {
            "minimum": 0.01,
            "type": "number"
          },
          "currency": {
            "minLength": 1,
            "pattern": "USD|EUR|GBP",
            "type": "string"
          },
          "fromAccount": {
            "minLength": 1,
            "pattern": "ACC-\\d+",
            "type": "string"
          },
          "reference": {
            "minLength": 1,
            "type": "string"
          },
          "toAccount": {
            "minLength": 1,
            "pattern": "ACC-\\d+",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency",
          "fromAccount",
          "reference",
          "toAccount"
        ],
        "type": "object"
      },
      "TransferResponse": {
        "properties": {
          "newBalance": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          },
          "transactionId": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "Keycloak access token; customer_id identifies the customer owner.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Order Management Platform",
      "url": "https://github.com/vamegah/order-management-platform"
    },
    "description": "Administrator banking facade over the legacy SOAP authority. Idempotency-Key preserves exact transfer retries and rejects conflicting payloads.",
    "title": "Banking Facade API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/banking/accounts/{accountNumber}/balance": {
      "get": {
        "operationId": "BankingAdapter_balance",
        "parameters": [
          {
            "in": "path",
            "name": "accountNumber",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Invalid banking request"
          },
          "401": {
            "description": "Missing or invalid authentication credentials."
          },
          "403": {
            "description": "The authenticated identity is not authorized for this operation."
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Account not found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Banking request declined"
          },
          "429": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Daily banking limit exceeded"
          },
          "502": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Invalid upstream banking response"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Banking service unavailable"
          }
        },
        "tags": [
          "banking-adapter-controller"
        ],
        "x-method-authorization": "hasRole('admin')"
      }
    },
    "/api/v1/banking/transfers": {
      "post": {
        "operationId": "BankingAdapter_transfer",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Invalid banking request"
          },
          "401": {
            "description": "Missing or invalid authentication credentials."
          },
          "403": {
            "description": "The authenticated identity is not authorized for this operation."
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Account not found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Banking request declined"
          },
          "429": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Daily banking limit exceeded"
          },
          "502": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Invalid upstream banking response"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Banking service unavailable"
          }
        },
        "tags": [
          "banking-adapter-controller"
        ],
        "x-method-authorization": "hasRole('admin')"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "description": "Development through Traefik",
      "url": "http://banking.localhost"
    },
    {
      "description": "Current ingress origin",
      "url": "/"
    }
  ],
  "x-implemented-routes": [
    "GET /api/v1/banking/accounts/{accountNumber}/balance",
    "POST /api/v1/banking/transfers"
  ]
}
