{
  "components": {
    "schemas": {
      "CategoryDto": {
        "description": "A product category",
        "properties": {
          "description": {
            "description": "Optional description",
            "type": "string"
          },
          "id": {
            "description": "Server-generated unique identifier",
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "description": "Display name",
            "example": "Laptops",
            "type": "string"
          },
          "parent": {
            "$ref": "#/components/schemas/CategorySummaryDto",
            "description": "Parent category, or null for roots"
          },
          "slug": {
            "description": "URL-friendly identifier",
            "example": "laptops",
            "type": "string"
          },
          "sortOrder": {
            "description": "Sort order among siblings",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "CategorySummaryDto": {
        "description": "A minimal category reference",
        "properties": {
          "id": {
            "description": "Unique identifier",
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "description": "Display name",
            "example": "Laptops",
            "type": "string"
          },
          "slug": {
            "description": "URL-friendly identifier",
            "example": "laptops",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CreateImageRequest": {
        "description": "Image for a new product",
        "properties": {
          "altText": {
            "description": "Alt text",
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "url": {
            "description": "Image URL",
            "maxLength": 2000,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "CreatePriceRequest": {
        "description": "Price for a new product",
        "properties": {
          "amount": {
            "description": "Amount (must be non-negative)",
            "example": 2499.99,
            "type": "number"
          },
          "currency": {
            "description": "ISO 4217 currency code",
            "example": "USD",
            "minLength": 1,
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "type": "object"
      },
      "CreateProductRequest": {
        "description": "Request body for creating a product",
        "properties": {
          "categoryId": {
            "description": "Category ID. Must reference an existing category.",
            "format": "uuid",
            "type": "string"
          },
          "description": {
            "description": "Optional description",
            "maxLength": 4000,
            "minLength": 0,
            "type": "string"
          },
          "images": {
            "description": "Optional images. Ordering is by position in the list.",
            "items": {
              "$ref": "#/components/schemas/CreateImageRequest"
            },
            "type": "array"
          },
          "name": {
            "description": "Display name",
            "example": "Pro Laptop 14\"",
            "maxLength": 300,
            "minLength": 0,
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/CreatePriceRequest",
            "description": "Price"
          },
          "sku": {
            "description": "Stock Keeping Unit. Will be normalized to uppercase.",
            "example": "LAPTOP-PRO-14",
            "maxLength": 64,
            "minLength": 4,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{3,63}$",
            "type": "string"
          }
        },
        "required": [
          "categoryId",
          "name",
          "price",
          "sku"
        ],
        "type": "object"
      },
      "FieldError": {
        "description": "A field-level validation error",
        "properties": {
          "field": {
            "description": "Field path",
            "example": "sku",
            "type": "string"
          },
          "message": {
            "description": "Error message",
            "example": "must be at least 4 characters",
            "type": "string"
          },
          "rejectedValue": {
            "description": "Rejected value",
            "example": "x"
          }
        },
        "type": "object"
      },
      "MoneyDto": {
        "description": "A monetary amount in a specific currency",
        "properties": {
          "amount": {
            "description": "Amount with 4 decimal places",
            "example": 2499.99,
            "type": "number"
          },
          "currency": {
            "description": "ISO 4217 currency code",
            "example": "USD",
            "type": "string"
          }
        },
        "type": "object"
      },
      "PageResponseProductDto": {
        "description": "A page of results",
        "properties": {
          "content": {
            "description": "Items on this page",
            "items": {
              "$ref": "#/components/schemas/ProductDto"
            },
            "type": "array"
          },
          "first": {
            "description": "True if this is the first page",
            "type": "boolean"
          },
          "last": {
            "description": "True if this is the last page",
            "type": "boolean"
          },
          "page": {
            "description": "Zero-based page index",
            "example": 0,
            "format": "int32",
            "type": "integer"
          },
          "size": {
            "description": "Page size",
            "example": 20,
            "format": "int32",
            "type": "integer"
          },
          "totalElements": {
            "description": "Total items matching the query",
            "example": 47,
            "format": "int64",
            "type": "integer"
          },
          "totalPages": {
            "description": "Total pages",
            "example": 3,
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ProblemDetails": {
        "description": "RFC 7807 problem details",
        "properties": {
          "detail": {
            "description": "Explanation specific to this occurrence",
            "example": "Product not found: 00000000-0000-0000-0000-000000000201",
            "type": "string"
          },
          "errors": {
            "description": "Field-level errors (for 400 responses)",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "extensions": {
            "additionalProperties": {},
            "description": "Additional properties, as allowed by RFC 7807",
            "type": "object"
          },
          "instance": {
            "description": "URI reference for this specific occurrence",
            "example": "/api/v1/products/00000000-0000-0000-0000-000000000201",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 404,
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "description": "Short, human-readable summary",
            "example": "Not Found",
            "type": "string"
          },
          "traceId": {
            "description": "Trace ID for correlation",
            "example": "4bf92f3577b34da6a3ce929d0e0e4736",
            "type": "string"
          },
          "type": {
            "description": "URI reference identifying the problem type",
            "example": "about:blank",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProductDto": {
        "description": "A product in the catalog",
        "properties": {
          "category": {
            "$ref": "#/components/schemas/CategoryDto",
            "description": "Category, or null if uncategorized"
          },
          "createdAt": {
            "description": "Creation timestamp (UTC)",
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "description": "Longer description",
            "example": "High-performance 14-inch laptop...",
            "type": "string"
          },
          "id": {
            "description": "Server-generated unique identifier",
            "example": "00000000-0000-0000-0000-000000000201",
            "format": "uuid",
            "type": "string"
          },
          "images": {
            "description": "Product images, ordered by sortOrder",
            "items": {
              "$ref": "#/components/schemas/ProductImageDto"
            },
            "type": "array"
          },
          "name": {
            "description": "Display name",
            "example": "Pro Laptop 14\"",
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/MoneyDto",
            "description": "Price"
          },
          "sku": {
            "description": "Stock Keeping Unit. Case-insensitive unique.",
            "example": "LAPTOP-PRO-14",
            "type": "string"
          },
          "status": {
            "description": "Lifecycle status",
            "example": "ACTIVE",
            "type": "string"
          },
          "updatedAt": {
            "description": "Last modification timestamp (UTC)",
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProductImageDto": {
        "description": "A product image",
        "properties": {
          "altText": {
            "description": "Alt text for accessibility",
            "type": "string"
          },
          "id": {
            "description": "Server-generated unique identifier",
            "format": "uuid",
            "type": "string"
          },
          "sortOrder": {
            "description": "Sort order (lower = shown first)",
            "format": "int32",
            "type": "integer"
          },
          "url": {
            "description": "Image URL",
            "example": "https://cdn.example.com/products/pro-laptop-14-front.jpg",
            "type": "string"
          }
        },
        "type": "object"
      },
      "UpdateImageRequest": {
        "description": "Image update",
        "properties": {
          "altText": {
            "description": "Alt text",
            "type": "string"
          },
          "url": {
            "description": "Image URL",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "UpdatePriceRequest": {
        "description": "Price update",
        "properties": {
          "amount": {
            "description": "Amount",
            "example": 2399.99,
            "type": "number"
          },
          "currency": {
            "description": "Currency code",
            "example": "USD",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "type": "object"
      },
      "UpdateProductRequest": {
        "description": "Request body for updating a product",
        "properties": {
          "categoryId": {
            "description": "Category ID",
            "format": "uuid",
            "type": "string"
          },
          "description": {
            "description": "Description",
            "maxLength": 4000,
            "minLength": 0,
            "type": "string"
          },
          "images": {
            "description": "Replacement image list. Pass empty list to remove all images.",
            "items": {
              "$ref": "#/components/schemas/UpdateImageRequest"
            },
            "type": "array"
          },
          "name": {
            "description": "Display name",
            "example": "Pro Laptop 14\" (2025)",
            "maxLength": 300,
            "minLength": 0,
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/UpdatePriceRequest",
            "description": "Price"
          }
        },
        "required": [
          "categoryId",
          "name",
          "price"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "Keycloak access token; customer_id identifies the customer owner.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Order Management Platform",
      "url": "https://github.com/vamegah/order-management-platform"
    },
    "description": "Authenticated catalog reads and administrator writes. Product lines remain queryable after soft deletion.",
    "title": "Product Service API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/categories": {
      "get": {
        "description": "Returns a flat list of all categories. Clients build the tree from parent references.",
        "operationId": "Category_list",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CategoryDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Missing or invalid authentication credentials."
          },
          "403": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "500": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List all categories",
        "tags": [
          "Categories"
        ]
      }
    },
    "/api/v1/categories/{slug}": {
      "get": {
        "operationId": "Category_getBySlug",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryDto"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Missing or invalid authentication credentials."
          },
          "403": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "500": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get a category by slug",
        "tags": [
          "Categories"
        ]
      }
    },
    "/api/v1/products": {
      "get": {
        "description": "Paginated listing with optional filters. Returns only ACTIVE products unless a status filter is provided.",
        "operationId": "Product_list",
        "parameters": [
          {
            "description": "Filter by category slug",
            "in": "query",
            "name": "categorySlug",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by category ID",
            "in": "query",
            "name": "categoryId",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Filter by status (ACTIVE, INACTIVE, DISCONTINUED)",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Case-insensitive substring match on name",
            "in": "query",
            "name": "nameQuery",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page number (0-based)",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "description": "Page size (1-100)",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "description": "Sort field and direction, e.g. 'name,asc'",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseProductDto"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Missing or invalid authentication credentials."
          },
          "403": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "500": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List products",
        "tags": [
          "Products"
        ]
      },
      "post": {
        "operationId": "Product_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDto"
                }
              }
            },
            "description": "Product created"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid request body"
          },
          "401": {
            "description": "Missing or invalid authentication credentials."
          },
          "403": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "SKU already exists"
          },
          "500": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create a new product",
        "tags": [
          "Products"
        ],
        "x-method-authorization": "hasRole('admin')"
      }
    },
    "/api/v1/products/batch": {
      "get": {
        "operationId": "Product_batch",
        "parameters": [
          {
            "in": "query",
            "name": "ids",
            "required": true,
            "schema": {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProductDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Missing or invalid authentication credentials."
          },
          "403": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "500": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Read 1 to 100 products in request order; missing IDs and duplicates are omitted",
        "tags": [
          "Products"
        ]
      }
    },
    "/api/v1/products/search": {
      "get": {
        "description": "Returns up to 50 products matching the query. Uses trigram similarity.",
        "operationId": "Product_search",
        "parameters": [
          {
            "description": "Search query (min 2 chars)",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProductDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Missing or invalid authentication credentials."
          },
          "403": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
