{
  "components": {
    "schemas": {
      "AuditView": {
        "properties": {
          "actorIssuer": {
            "type": "string"
          },
          "actorSubject": {
            "type": "string"
          },
          "candidateReference": {
            "type": "string"
          },
          "completedAt": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "detailCode": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "refundId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ChargeHttpRequest": {
        "properties": {
          "amountMinor": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "currency": {
            "minLength": 1,
            "pattern": "^[A-Za-z]{3}$",
            "type": "string"
          },
          "idempotencyKey": {
            "minLength": 1,
            "type": "string"
          },
          "orderId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "currency",
          "idempotencyKey",
          "orderId"
        ],
        "type": "object"
      },
      "ChargeResponse": {
        "properties": {
          "failureCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "failureMessage": {
            "type": [
              "string",
              "null"
            ]
          },
          "paymentId": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "providerReference": {
            "type": [
              "string",
              "null"
            ]
          },
          "requiresActionUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "PaymentResponse": {
        "properties": {
          "amountMinor": {
            "format": "int64",
            "type": "integer"
          },
          "capturedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "customerId": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "failedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "failureCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "failureMessage": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "orderId": {
            "format": "uuid",
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "providerReference": {
            "type": [
              "string",
              "null"
            ]
          },
          "refundedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "RecoveryResponse": {
        "properties": {
          "attempts": {
            "format": "int32",
            "type": "integer"
          },
          "attentionReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastError": {
            "type": [
              "string",
              "null"
            ]
          },
          "nextAttemptAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "refund": {
            "$ref": "#/components/schemas/RefundResponse"
          }
        },
        "type": "object"
      },
      "RefundHttpRequest": {
        "properties": {
          "amountMinor": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "idempotencyKey": {
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "idempotencyKey"
        ],
        "type": "object"
      },
      "RefundResponse": {
        "properties": {
          "amountMinor": {
            "format": "int64",
            "type": "integer"
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "paymentId": {
            "format": "uuid",
            "type": "string"
          },
          "providerReference": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Request": {
        "properties": {
          "providerReference": {
            "minLength": 1,
            "pattern": "re_[A-Za-z0-9_]{1,240}",
            "type": "string"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "providerReference",
          "reason"
        ],
        "type": "object"
      },
      "Response": {
        "properties": {
          "audit": {
            "$ref": "#/components/schemas/AuditView"
          },
          "recovery": {
            "$ref": "#/components/schemas/RecoveryResponse"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "Keycloak access token; customer_id identifies the customer owner.",
        "scheme": "bearer",
        "type": "http"
      },
      "noopSignature": {
        "description": "Configured Noop development-provider signature.",
        "in": "header",
        "name": "X-Noop-Signature",
        "type": "apiKey"
      },
      "providerSignature": {
        "description": "Provider HMAC signature over the unmodified request bytes; this callback does not accept a JWT as its authentication.",
        "in": "header",
        "name": "Stripe-Signature",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Order Management Platform",
      "url": "https://github.com/vamegah/order-management-platform"
    },
    "description": "Owner-scoped payment and refund operations, administrator recovery and signed provider callbacks. Caller idempotency keys are reused after uncertain outcomes.",
    "title": "Payment HTTP API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/payments": {
      "post": {
        "operationId": "Payment_charge",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChargeHttpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ChargeResponse"
                }
              }
            },
            "description": "Charge confirmed"
          },
          "202": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ChargeResponse"
                }
              }
            },
            "description": "Customer action required"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Missing or invalid authentication credentials."
          },
          "402": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ChargeResponse"
                }
              }
            },
            "description": "Charge declined"
          },
          "403": {
            "description": "The authenticated identity is not authorized for this operation."
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "*/*": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "Conflict"
          },
          "502": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ChargeResponse"
                }
              }
            },
            "description": "Provider outcome unavailable"
          }
        },
        "tags": [
          "payment-controller"
        ]
      }
    },
    "/api/v1/payments/webhooks/{providerName}": {
      "post": {
        "operationId": "StripeWebhook_receive",
        "parameters": [
          {
            "in": "path",
            "name": "providerName",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "description": "Original provider JSON bytes. The signature is verified before processing; clients must not reserialize signed payloads.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "Verified event accepted, duplicated or ignored"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "*/*": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "Provider signature rejected"
          },
          "403": {
            "description": "The authenticated identity is not authorized for this operation."
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "Unknown provider"
          },
          "409": {
            "content": {
              "*/*": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "Conflict"
          },
          "500": {
            "content": {
              "*/*": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "Event processing failed; provider should retry"
          }
        },
        "security": [
          {
            "noopSignature": []
          },
          {
            "providerSignature": []
          }
        ],
        "tags": [
          "stripe-webhook-controller"
        ]
      }
    },
