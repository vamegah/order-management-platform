{
  "Date": {
    "input": {
      "type": "string",
      "format": "date"
    },
    "output": {
      "type": "string",
      "format": "date"
    }
  },
  "DateTime": {
    "input": {
      "type": "string",
      "format": "date-time"
    },
    "output": {
      "type": "string",
      "format": "date-time"
    }
  },
  "Decimal": {
    "input": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        }
      ]
    },
    "output": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    }
  }
}
