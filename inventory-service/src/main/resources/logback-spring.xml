<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback configuration for inventory-service.

  Identical to Phase 1 services. Writes JSON to stdout; Promtail ships to
  Loki. The service name field comes from spring.application.name (which is
  "inventory-service"). MDC fields (trace_id, span_id, request_id) are
  included automatically.

  Override: LOG_FORMAT=text for human-readable output.
-->
<configuration>

  <springProperty scope="context" name="serviceName"
                  source="spring.application.name" defaultValue="unknown"/>
  <springProperty scope="context" name="envName"
                  source="PROMETHEUS_ENV" defaultValue="local"/>

  <property name="LOG_FORMAT" value="${LOG_FORMAT:-json}"/>

  <appender name="json" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <customFields>{"service":"${serviceName}","env":"${envName}"}</customFields>
      <includeMdc>true</includeMdc>
      <includeContext>false</includeContext>
      <includeCallerData>false</includeCallerData>
      <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
      <timeZone>UTC</timeZone>
      <fieldNames>
        <timestamp>timestamp</timestamp>
        <message>message</message>
        <logger>logger</logger>
        <thread>thread</thread>
        <levelValue>[ignore]</levelValue>
      </fieldNames>
      <shortenedLoggerNameLength>40</shortenedLoggerNameLength>
    </encoder>
  </appender>

  <appender name="text" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{ISO8601} [%thread] %-5level [%X{trace_id:-},%X{span_id:-}] %logger{40} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="${LOG_FORMAT}"/>
  </root>

</configuration>