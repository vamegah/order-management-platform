<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =====================================================================
         PROJECT COORDINATES
         ===================================================================== -->
    <groupId>com.example.omp</groupId>
    <artifactId>order-management-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Order Management Platform</name>
    <description>
        Enterprise reference application demonstrating REST, SOAP, GraphQL,
        gRPC, WebSocket, and Webhook architectures in a single cohesive
        system.
    </description>

    <!-- =====================================================================
         MODULES
         Maven builds these in order. The order matters for reactor
         resolution: modules that other modules depend on must be listed
         first.

         Currently active:
           - shared/domain       (value objects)
           - shared/common-web   (web utilities)
           - shared/proto        (protobuf definitions)
           - shared/events       (Kafka event schemas)
           - product-service
           - customer-service
           - order-service
           - graphql-gateway
           - inventory-service
           - payment-service
           - notification-service
           - payment-provider-simulator
           - integration-tests
           - legacy-banking-adapter (REST facade over SOAP)
           - legacy-bank-service (SOAP simulator)
           - platform-tests
         ===================================================================== -->
    <modules>
        <!-- Shared modules — leaf dependencies, no service dependencies. -->
        <module>shared/domain</module>
        <module>shared/common-web</module>
        <module>shared/proto</module>
        <module>shared/events</module>
        <module>shared/grpc</module>

        <!-- Business services. -->
        <module>product-service</module>
        <module>customer-service</module>
        <module>order-service</module>

        <!-- Gateways and non-domain services. -->
        <module>graphql-gateway</module>
        <module>inventory-service</module>
        <module>payment-service</module>
        <module>payment-provider-simulator</module>
        <module>notification-service</module>

        <!-- Integration tests run against a deployed stack. -->
        <module>integration-tests</module>
        <module>legacy-banking-adapter</module>
        <module>legacy-bank-service</module>
        <module>platform-tests</module>
    </modules>

    <!-- =====================================================================
         PROPERTIES
         Central place for all version numbers and shared configuration.
         Child modules reference these properties; they never hardcode
         versions themselves.
         ===================================================================== -->
    <properties>
        
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

       
        <!-- Spring Boot is the framework BOM source. It manages
             versions for Spring Framework, Jackson, Micrometer, Kafka
             clients, Logback, Log4j, Tomcat, Netty, JUnit 5, AssertJ,
             Mockito, Testcontainers (partial), and dozens more. -->
        <spring-boot.version>4.1.2</spring-boot.version>

        <!-- Spring Cloud 2025.1.2+ supports Spring Boot 4.1.x. Provides LoadBalancer,
             Spring Cloud OpenFeign, and other integration. -->
        <spring-cloud.version>2025.1.4</spring-cloud.version>

        
        <grpc.version>1.84.1</grpc.version>
        <protobuf.version>4.36.2</protobuf.version>
        <protobuf-maven-plugin.version>0.6.1</protobuf-maven-plugin.version>
        <os-maven-plugin.version>1.7.1</os-maven-plugin.version>

        <!-- net.devh transport compatibility is verified by the real RPC suites. -->
        <grpc-spring-boot-starter.version>3.1.0.RELEASE</grpc-spring-boot-starter.version>

        <!-- Tomcat annotations API. Required by code generated by
             protoc-gen-grpc-java, which uses @javax.annotation.Generated
             (mapped to jakarta via this artifact). -->
        <tomcat-annotations-api.version>6.0.53</tomcat-annotations-api.version>

        
        <postgresql.version>42.7.14</postgresql.version>
        <flyway.version>12.4.0</flyway.version>

       
        <!-- Spring Boot's BOM manages the complete Kafka dependency family,
             including standalone clients and the embedded test broker. -->

        
        <!-- Keycloak runs as a container; no Java client dependency is
             needed. But JJWT is used for potential custom JWT handling. -->
        <jjwt.version>0.12.6</jjwt.version>

        
        <resilience4j.version>2.4.0</resilience4j.version>

        
        <!-- Micrometer Tracing is managed by Spring Boot's BOM. The
             OpenTelemetry API/SDK/exporter versions are not always aligned
             in the BOM across Spring Boot releases; we pin them here to
             avoid transitively-resolved inconsistencies. -->
        <opentelemetry.version>1.62.0</opentelemetry.version>

        <!-- Logstash Logback Encoder is not in Spring Boot's BOM. -->
        <logstash-logback-encoder.version>8.0</logstash-logback-encoder.version>

        
        <springdoc.version>3.2.0</springdoc.version>

        
        <!-- Includes Docker Engine 29 API compatibility on the 1.x API line. -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <rest-assured.version>6.0.1</rest-assured.version>
        <json-schema-validator.version>${rest-assured.version}</json-schema-validator.version>
        <wiremock.version>3.9.1</wiremock.version>
        <archunit.version>1.3.0</archunit.version>

        
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-install-plugin.version>3.1.3</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.1.3</maven-deploy-plugin.version>
        <jib-maven-plugin.version>3.4.3</jib-maven-plugin.version>
        <spotless-maven-plugin.version>2.43.0</spotless-maven-plugin.version>
        <google-java-format.version>1.23.0</google-java-format.version>
        <jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version>
        <build-helper-maven-plugin.version>3.6.0</build-helper-maven-plugin.version>
        <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
        <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
        <dependency-check-maven.version>13.0.0</dependency-check-maven.version>
        <!-- A full verify includes container ITs; e2e additionally needs a running stack. -->
        <test.excludedGroups>e2e</test.excludedGroups>
    </properties>

    <!-- =====================================================================
         DEPENDENCY MANAGEMENT
         Declares versions for every dependency any child module uses.
         Child modules then declare dependencies WITHOUT <version>, and
         Maven resolves from here.

         Order: import BOMs first (their managed versions take precedence
         over anything declared later for the same artifact), then add
         explicit entries for libraries the BOMs don't cover.
         ===================================================================== -->
    <dependencyManagement>
        <dependencies>

            <!-- Import before Spring Boot: Maven uses the first imported BOM
                 for overlapping dependency versions. Keep every Testcontainers
                 module on the Docker-compatible version selected above. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-bom</artifactId>
                <version>2.4.21</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== Spring Boot BOM ========== -->
            <!-- Manages ~400 dependencies: Spring Framework 7.x, Jackson,
                 Micrometer, Kafka clients, Logback, Log4j, Tomcat, Netty,
                 JUnit 5, AssertJ, Mockito, HikariCP, Flyway, Postgres
                 driver (via dependency declaration), Spring Security,
                 Spring Data, Spring WebFlux, and many more. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== Spring Cloud BOM ========== -->
            <!-- Manages Spring Cloud LoadBalancer, OpenFeign, Gateway,
                 Config, etc. Spring Boot retains precedence for overlapping
                 versions because its BOM is imported first. -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== gRPC BOM ========== -->
            <!-- Aligns grpc-netty, grpc-protobuf, grpc-stub, grpc-api,
                 grpc-core, grpc-testing. -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== Resilience4j BOM ========== -->
            <!-- Aligns resilience4j-circuitbreaker, resilience4j-retry,
                 resilience4j-spring-boot4, resilience4j-micrometer, etc. -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.apache.wss4j</groupId>
                <artifactId>wss4j-ws-security-dom</artifactId>
                <version>4.0.2</version>
            </dependency>
            <dependency>
                <groupId>commons-fileupload</groupId>
                <artifactId>commons-fileupload</artifactId>
                <version>1.6.0</version>
            </dependency>

            <dependency>
                <groupId>org.springframework.retry</groupId>
                <artifactId>spring-retry</artifactId>
                <version>2.0.13</version>
            </dependency>

            <!-- ========== Protobuf runtime ========== -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot4</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <!-- Not in Spring Boot's BOM. -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java-util</artifactId>
                <version>${protobuf.version}</version>
            </dependency>

            <!-- ========== grpc-spring-boot-starter (net.devh) ========== -->
            <!-- Not in Spring Boot's BOM. Server-side starter used by
                 inventory-service and payment-service. -->
            <dependency>
                <groupId>net.devh</groupId>
                <artifactId>grpc-spring-boot-starter</artifactId>
                <version>${grpc-spring-boot-starter.version}</version>
            </dependency>

            <!-- Client-side starter for callers (order-service,
                 integration-tests). -->
            <dependency>
                <groupId>net.devh</groupId>
                <artifactId>grpc-client-spring-boot-starter</artifactId>
                <version>${grpc-spring-boot-starter.version}</version>
            </dependency>

            <!-- ========== Tomcat annotations API ========== -->
            <!-- Required at compile time by generated gRPC stubs. -->
            <dependency>
                <groupId>org.apache.tomcat</groupId>
                <artifactId>annotations-api</artifactId>
                <version>${tomcat-annotations-api.version}</version>
            </dependency>

            <!-- ========== PostgreSQL JDBC driver ========== -->
            <!-- Spring Boot's BOM declares postgresql as a managed
                 dependency. We pin explicitly to be sure across
                 Spring Boot patch releases. -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>

            <!-- ========== Flyway ========== -->
            <!-- Spring Boot's BOM manages flyway-core; we add
                 flyway-database-postgresql explicitly (it's a separate
                 artifact since Flyway 10). -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <!-- Kafka clients and broker test artifacts stay on Boot's BOM.
                 Pinning only kafka-clients breaks EmbeddedKafka binary linkage. -->

            <!-- ========== JJWT ========== -->
            <!-- Not in Spring Boot's BOM. Used if we need to construct
                 JWTs programmatically (rare; mostly we validate them via
                 spring-security-oauth2-resource-server). -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- ========== OpenTelemetry ========== -->
            <!-- The OTLP exporter is used by each service to export
                 traces. Spring Boot's BOM manages this transitively via
                 micrometer-tracing-bridge-otel, but pinning here avoids
                 version drift when Spring Boot's transitive version is
                 not what we expect. -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-exporter-otlp</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>

            <!-- ========== Logstash Logback Encoder ========== -->
            <!-- Not in Spring Boot's BOM. -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>

            <!-- ========== SpringDoc OpenAPI ========== -->
            <!-- Not in Spring Boot's BOM. -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- Includes DOMPurify 3.4.17, fixing the bundled sanitizer findings. -->
            <dependency>
                <groupId>org.webjars</groupId>
                <artifactId>swagger-ui</artifactId>
                <version>5.34.1</version>
            </dependency>

            <!-- ========== REST Assured ========== -->
            <!-- Not in Spring Boot's BOM. -->
            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>rest-assured</artifactId>
                <version>${rest-assured.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${json-schema-validator.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- ========== WireMock ========== -->
            <!-- Not in Spring Boot's BOM. -->
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- ========== ArchUnit ========== -->
            <!-- Not in Spring Boot's BOM. Used for architecture tests. -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- ========== gRPC testing ========== -->
            <!-- In the grpc-bom; declared explicitly for scope clarity. -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-testing</artifactId>
                <version>${grpc.version}</version>
                <scope>test</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
            <!-- Override the obsolete redirect inherited from WSS4J's parent. -->
            <id>B_shibboleth</id>
            <name>Shibboleth releases</name>
            <url>https://build.shibboleth.net/maven/releases/</url>
            <releases><checksumPolicy>fail</checksumPolicy></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <!-- =====================================================================
         DEPENDENCIES (inherited by all modules)
         Only things every module genuinely needs. Currently: JUnit 5,
         AssertJ, Mockito — all test-scoped.
         ===================================================================== -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- =====================================================================
         BUILD
         Plugin management (declares configuration; children opt in) and
         active plugins (run in every module).
         ===================================================================== -->
    <build>

        <!-- Extensions active for all modules. os-maven-plugin is required
             by protobuf-maven-plugin to detect the OS and pick the correct
             protoc binary. Declaring it here avoids each gRPC-consuming
             module redeclaring it. -->
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>${os-maven-plugin.version}</version>
            </extension>
        </extensions>

        <pluginManagement>
            <plugins>

                
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>

                
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                    <configuration>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>

                
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                        </includes>
                        <excludes>
                            <exclude>**/*IT.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>

                
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <includes>
                            <include>**/*IT.java</include>
                        </includes>
                        <excludedGroups>${test.excludedGroups}</excludedGroups>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                
                <!-- Applied per-service that produces an executable jar. -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <configuration>
                        <!-- Keep a normal jar for reactor test dependencies. -->
                        <classifier>exec</classifier>
                        <layers>
                            <enabled>true</enabled>
                        </layers>
                    </configuration>
                    <executions>
                        <execution>
                            <id>repackage</id>
                            <goals><goal>repackage</goal></goals>
                        </execution>
                    </executions>
                </plugin>

                
                <!-- Used by shared/proto. Consuming modules depend on the
                     generated jar, so they don't run this plugin. -->
                <plugin>
                    <groupId>org.xolstice.maven.plugins</groupId>
                    <artifactId>protobuf-maven-plugin</artifactId>
                    <version>${protobuf-maven-plugin.version}</version>
                    <configuration>
                        <protocArtifact>
                            com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}
                        </protocArtifact>
                        <pluginId>grpc-java</pluginId>
                        <pluginArtifact>
                            io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}
                        </pluginArtifact>
                    </configuration>
                </plugin>

                
                <!-- Adds generated-source directories to the compile path.
                     Used by shared/proto. -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build-helper-maven-plugin.version}</version>
                </plugin>

                
                <!-- Applied per-service that wants coverage enforcement. -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-maven-plugin.version}</version>
                    <configuration>
                        <lineEndings>UNIX</lineEndings>
                        <java>
                            <googleJavaFormat>
                                <version>1.28.0</version>
                                <style>AOSP</style>
                            </googleJavaFormat>
                            <removeUnusedImports/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>
                    </configuration>
                </plugin>

                
                <!-- Optional per-service. We use Dockerfiles instead, but
                     the plugin is available if a service wants it. -->
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>${jib-maven-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-maven-plugin.version}</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>High</threshold>
                        <failOnError>true</failOnError>
                        <xmlOutput>true</xmlOutput>
                        <excludeFilterFile>${maven.multiModuleProjectDirectory}/infrastructure/quality/spotbugs-exclude.xml</excludeFilterFile>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.cyclonedx</groupId>
                    <artifactId>cyclonedx-maven-plugin</artifactId>
                    <version>${cyclonedx-maven-plugin.version}</version>
                    <configuration>
                        <schemaVersion>1.6</schemaVersion>
                        <outputFormat>all</outputFormat>
                        <outputReactorProjects>false</outputReactorProjects>
                        <includeTestScope>false</includeTestScope>
                        <excludeTestProject>true</excludeTestProject>
                        <skipAttach>true</skipAttach>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check-maven.version}</version>
                    <configuration>
                        <failBuildOnCVSS>7.0</failBuildOnCVSS>
                        <failOnError>true</failOnError>
                        <formats>
                            <format>HTML</format>
                            <format>JSON</format>
                        </formats>
                        <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                        <!-- Official feeds also work for fork PRs without repository secrets. -->
                        <nvdDatafeedUrl>https://nvd.nist.gov/feeds/json/cve/2.0/nvdcve-2.0-{0}.json.gz</nvdDatafeedUrl>
                        <nvdValidForHours>0</nvdValidForHours>
                        <!-- OSS Index requires separate credentials; NVD remains required. -->
                        <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                    </configuration>
                </plugin>

            </plugins>
        </pluginManagement>

        <!-- =================================================================
             ACTIVE PLUGINS (run in every module)
             Kept minimal. Only formatting is universally enforced.
             ================================================================= -->
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

    </build>

    <!-- =====================================================================
         PROFILES
         Activated via `mvn -P<name>`. Kept minimal.
         ===================================================================== -->
    <profiles>

        <!-- `mvn -Pit verify` — explicitly enables Failsafe in every module. -->
        <profile>
            <id>it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- `mvn -Pskip-tests package` — fast build without tests. -->
        <profile>
            <id>skip-tests</id>
            <properties>
                <skipTests>true</skipTests>
                <skipITs>true</skipITs>
            </properties>
        </profile>

        <!-- `mvn -Pe2e verify` — enables e2e tests in the integration-tests
             module (which requires a running stack). -->
        <profile>
            <id>e2e</id>
            <properties>
                <!-- Include e2e without filtering out untagged integration tests. -->
                <test.excludedGroups></test.excludedGroups>
            </properties>
        </profile>

        <profile>
            <id>static-analysis</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>spotbugs-check</id>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>supply-chain</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <inherited>false</inherited>
                    </plugin>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <inherited>false</inherited>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

</project>
