<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://legacybank.example.com/ws"
           targetNamespace="http://legacybank.example.com/ws"
           elementFormDefault="qualified">

    <!-- ============ Requests ============ -->

    <xs:element name="TransferFundsRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="fromAccount" type="xs:string"/>
                <xs:element name="toAccount"   type="xs:string"/>
                <xs:element name="amount"      type="xs:decimal"/>
                <xs:element name="currency"    type="xs:string"/>
                <xs:element name="reference"   type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GetAccountBalanceRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="accountNumber" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="ReverseTransactionRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="transactionId" type="xs:string"/>
                <xs:element name="reason"        type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ============ Responses ============ -->

    <xs:element name="TransferFundsResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="transactionId" type="xs:string"/>
                <xs:element name="status"        type="xs:string"/>
                <xs:element name="timestamp"     type="xs:dateTime"/>
                <xs:element name="newBalance"    type="xs:decimal"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GetAccountBalanceResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="accountNumber" type="xs:string"/>
                <xs:element name="balance"       type="xs:decimal"/>
                <xs:element name="currency"      type="xs:string"/>
                <xs:element name="timestamp"     type="xs:dateTime"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="ReverseTransactionResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="transactionId" type="xs:string"/>
                <xs:element name="status"        type="xs:string"/>
                <xs:element name="timestamp"     type="xs:dateTime"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ============ Faults ============ -->

    <xs:element name="BankingFault">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="code"    type="xs:string"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>