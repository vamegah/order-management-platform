# ==============================================================================
# Order Management Platform — Production Environment Template
# ------------------------------------------------------------------------------
# USAGE
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#   vim .env.prod   # set OMP_DOMAIN, ACME_EMAIL, TRAEFIK_ADMIN_BASICAUTH
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#                  --env-file .env.prod up -d
#
# IMPORTANT
#   - This file contains NO SECRETS. Only configuration.
#   - Secrets live in /etc/omp/secrets/* (see SECRETS section below).
#   - `.env.prod` is GITIGNORED. This template is committed.
#   - All values below are examples; replace with your environment's values.
#
# DIFFERENCES FROM .env.example (dev)
#   - No passwords. Password-shaped values are rejected by review.
#   - Requires a real public domain (OMP_DOMAIN). Let's Encrypt will not
#     issue certificates for localhost or any name it can't reach on port 80.
#   - Admin tools (pgAdmin, Kafka UI) are not deployed; their variables are
#     omitted here.
#   - Traefik dashboard, Prometheus, and Keycloak admin are gated by a
#     bcrypt-hashed basic auth credential. See TRAEFIK_ADMIN_BASICAUTH below.
#
# SPECIAL CHARACTERS
#   Values containing `$` MUST escape it as `$$`. Docker Compose interprets
#   `$` as a variable reference, so an unescaped bcrypt hash like
#   `$2y$05$abc...` would be corrupted to `y...` after substitution (with
#   a warning). The correct form is `$$2y$$05$$abc...`.
#
#   This file is the one where this matters most: TRAEFIK_ADMIN_BASICAUTH
#   is a bcrypt hash and starts with `$2y$`. Compose will not error on
#   unescaped `$` — it will silently produce a broken hash, and Traefik
#   basic auth will fail with a "401" that is very hard to diagnose.
#
#   Other special characters:
#     - `#` starts a comment mid-line: quote the value or avoid `#`.
#     - spaces: quote the value (`FOO="hello world"`), or better, regenerate
#       to eliminate spaces.
#
#   After editing this file, ALWAYS run `docker compose config` (see
#   VERIFICATION CHECKLIST below) to confirm every variable resolves as
#   expected. The output shows the fully-substituted values, so a mangled
#   bcrypt hash is immediately visible.

# ------------------------------------------------------------------------------
# COMPOSE PROJECT
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=omp

# ------------------------------------------------------------------------------
# DEPLOYMENT IDENTITY
# ------------------------------------------------------------------------------
# A short label identifying this environment. Used in dashboards, log
# correlation, and alert routing. Common values: prod, staging, canary.
# ------------------------------------------------------------------------------
OMP_ENV=prod

# ------------------------------------------------------------------------------
# PUBLIC DOMAIN
# ------------------------------------------------------------------------------
# The root domain under which every service is exposed. Traefik uses this to
# route by Host header, and Let's Encrypt uses it to request certificates.
#
# REQUIREMENTS
#   - Must be a real, resolvable DNS name.
#   - All wildcard subdomains must point to this host's public IP:
#         auth.<OMP_DOMAIN>
#         keycloak-admin.<OMP_DOMAIN>
#         grafana.<OMP_DOMAIN>
#         prometheus.<OMP_DOMAIN>
#         traefik.<OMP_DOMAIN>
#     (Plus any app-service subdomains added in later phases.)
#   - Ports 80 and 443 must be reachable from the internet for Let's Encrypt
#     HTTP-01 challenge. If they're not (air-gapped, corporate proxy, etc.),
#     switch to DNS-01 challenge in docker-compose.prod.yml.
#
# EXAMPLE
#   OMP_DOMAIN=api.example.com
#   → Traefik routes for auth.api.example.com, grafana.api.example.com, etc.
# ------------------------------------------------------------------------------
OMP_DOMAIN=REPLACE_WITH_YOUR_DOMAIN.example.com

# ------------------------------------------------------------------------------
# ACME / LET'S ENCRYPT
# ------------------------------------------------------------------------------
# Email address registered with Let's Encrypt. Used by:
#   - Expiry notifications (30 days before cert expires, if renewal fails)
#   - Recovery from lost cert resolver state
#
# Use a real address that a human monitors. Do not use noreply@ — if certs
# fail to renew, you want a real inbox to receive the alert.
# ------------------------------------------------------------------------------
ACME_EMAIL=ops@REPLACE_WITH_YOUR_DOMAIN.example.com

# ------------------------------------------------------------------------------
# TRAEFIK ADMIN BASIC AUTH
# ------------------------------------------------------------------------------
# A bcrypt-hashed credential in htpasswd format:
#     username:$2y$<bcrypt hash>
#
# Used by the `admin-auth` middleware protecting:
#   - traefik.<OMP_DOMAIN>       (Traefik dashboard)
#   - prometheus.<OMP_DOMAIN>    (Prometheus UI)
#   - keycloak-admin.<OMP_DOMAIN> (Keycloak admin console)
#
# GENERATE with one of these commands:
#
#   htpasswd -nbB admin 'your-strong-password'
#   # or, if htpasswd is unavailable:
#   docker run --rm httpd:alpine htpasswd -nbB admin 'your-strong-password'
#
# Output looks like:
#   admin:$2y$05$abcdefghijklmnopqrstuv...
#
# Paste the ENTIRE line (username:hash) as the value below.
#
# SECURITY NOTES
#   - Bcrypt hashes begin with $2a$, $2b$, or $2y$. Any is accepted.
#   - The `$` characters are literal — do NOT escape them.
#   - This IS a secret (or at least secret-adjacent). Treat it like one:
#     - Never commit it.
#     - Rotate it if any admin leaves the team.
#     - Change the underlying password at least every 90 days.
#
# EXAMPLE (do not use this hash):
#   TRAEFIK_ADMIN_BASICAUTH=admin:$2y$05$abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQR
# ------------------------------------------------------------------------------
TRAEFIK_ADMIN_BASICAUTH=admin:$2y$REPLACE_WITH_BCRYPT_HASH

# ------------------------------------------------------------------------------
# POSTGRESQL (non-secret configuration only)
# ------------------------------------------------------------------------------
# The database name and superuser name are NOT secrets — they're identifiers
# visible in logs, connection strings, and monitoring. The PASSWORD for the
# superuser is a secret and lives in /etc/omp/secrets/postgres_superuser_password.
#
# Do NOT add POSTGRES_SUPERPASSWORD here. If you're tempted, re-read the top
# of this file.
# ------------------------------------------------------------------------------
POSTGRES_DB=omp
POSTGRES_SUPERUSER=omp_admin

# ------------------------------------------------------------------------------
# KEYCLOAK (non-secret configuration only)
# ------------------------------------------------------------------------------
# The admin username is a public identifier. The password is a secret.
#
# In production, the Keycloak admin console is not publicly accessible — it's
# served on keycloak-admin.<OMP_DOMAIN>, which is gated by Traefik basic auth
# IN ADDITION to Keycloak's own admin login. Two factors, both required.
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin

# ------------------------------------------------------------------------------
# REDIS (non-secret configuration only)
# ------------------------------------------------------------------------------
# Redis in production runs in Sentinel mode (1 master + 2 replicas + 3 sentinels).
# The app services (Phase 1+) discover the current master via sentinel. Only
# the password is a secret; the topology is configuration.
#
# Sentinel hostnames are internal to the `data` Docker network. Do not expose
# them via public DNS.
# ------------------------------------------------------------------------------
REDIS_SENTINEL_MASTER_NAME=omp-master
REDIS_SENTINEL_HOSTS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379


# --- Batch 9.3: notification-service database ---
NOTIFICATION_SERVICE_DB_USER=notifications_svc
NOTIFICATION_SERVICE_DB_PASSWORD=__REPLACE_WITH_STRONG_SECRET__


# --- Batch 9.4: payment-service ---
PAYMENT_SERVICE_DB_USER=payments_svc
PAYMENT_SERVICE_DB_PASSWORD=__REPLACE_WITH_STRONG_SECRET__
PAYMENT_PROVIDER=stripe
STRIPE_API_KEY=__REPLACE_WITH_SECRET_KEY__
STRIPE_WEBHOOK_SECRET=__REPLACE_WITH_WEBHOOK_SECRET__

# ------------------------------------------------------------------------------
# KAFKA (non-secret configuration only)
# ------------------------------------------------------------------------------
# Bootstrap servers are internal hostnames, not secrets. The SCRAM credentials
# are secrets (one per client) and will be provisioned in Phase 5.
#
# Topic retention is configuration:
#   - 168 hours (7 days) for business events
#   - 24 hours for observability/debug topics
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092,kafka-2:9092,kafka-3:9092
KAFKA_BUSINESS_EVENTS_RETENTION_HOURS=168
KAFKA_DEBUG_EVENTS_RETENTION_HOURS=24

# ------------------------------------------------------------------------------
# OBSERVABILITY (non-secret configuration only)
# ------------------------------------------------------------------------------
# Data retention in Prometheus, Loki, and Tempo. Longer = more disk = more
# historical insight. Tune to your compliance requirements:
#   - SOC 2: often 90 days hot, 1 year cold
#   - PCI DSS: 1 year, 3 months immediately available
# ------------------------------------------------------------------------------
PROMETHEUS_RETENTION_TIME=15d
LOKI_RETENTION_PERIOD=720h          # 30 days
TEMPO_RETENTION_PERIOD=168h         # 7 days (traces are voluminous)
GRAFANA_ADMIN_USER=admin

# ------------------------------------------------------------------------------
# PROMETHEUS — environment label
# ------------------------------------------------------------------------------
# Applied as an external label to every metric Prometheus emits. Enables
# Grafana queries like `up{env="prod"}` and keeps prod metrics distinct
# from dev when a single Grafana instance serves both.
#
# The value flows: .env.prod → docker-compose.yml → container environment →
# prometheus.yml's ${PROMETHEUS_ENV} substitution → external label.
#
# CRITICAL: without this, the compose fallback (${PROMETHEUS_ENV:-dev})
# would label prod metrics as `env="dev"` — a subtle bug that pollutes dev
# dashboards and breaks prod-only queries. This variable is what makes
# the same prometheus.yml file behave correctly in both environments.
#
# Common values: prod, staging, canary (matching DEPLOYMENT IDENTITY above).
# ------------------------------------------------------------------------------
PROMETHEUS_ENV=prod

# ------------------------------------------------------------------------------
# BACKUP (non-secret configuration only)
# ------------------------------------------------------------------------------
# pgBackRest repository path and retention. The repository path is internal;
# the CIPHER key is a secret (see SECRETS section).
#
# RETENTION STRATEGY
#   - 14 full backups (retained indefinitely until count exceeded)
#   - 30 days of WAL archive (for point-in-time recovery)
#   - Full backups run daily at 02:00 host time
#   - Incremental backups run hourly
#   - WAL archiving is continuous
#
# Adjust retention only after consulting your compliance/legal teams. Shorter
# retention = cheaper storage but less recovery window.
# ------------------------------------------------------------------------------
PGBACKREST_RETENTION_FULL=14
PGBACKREST_RETENTION_WAL_DAYS=30
PGBACKREST_FULL_SCHEDULE="0 2 * * *"
PGBACKREST_INCR_SCHEDULE="0 * * * *"

# ------------------------------------------------------------------------------
# APPLICATION SERVICES (added in later phases)
# ------------------------------------------------------------------------------
# As each service is built, its non-secret config is listed here. Passwords
# and API keys are NEVER listed here — they become Docker secrets.
# ------------------------------------------------------------------------------

# --- ORDER SERVICE (Phase 1) ---
ORDER_SERVICE_DB_USER=orders_svc
ORDER_SERVICE_REPLICAS=2
ORDER_SERVICE_MEMORY_LIMIT=1G

# --- CUSTOMER SERVICE (Phase 1) ---
CUSTOMER_SERVICE_DB_USER=customers_svc
CUSTOMER_SERVICE_REPLICAS=2
CUSTOMER_SERVICE_MEMORY_LIMIT=1G

# --- PRODUCT SERVICE (Phase 1) ---
# DB password comes from a Docker secret (see SECRETS section). The
# username and schema are fixed.
PRODUCT_SERVICE_DB_USER=products_svc
PRODUCT_SERVICE_REPLICAS=2
PRODUCT_SERVICE_MEMORY_LIMIT=1G

# --- INVENTORY SERVICE (Phase 3) ---
# DB password comes from a Docker secret (see SECRETS section).
# Username and gRPC ports are fixed.
INVENTORY_SERVICE_DB_USER=inventory_svc
INVENTORY_SERVICE_REPLICAS=2
INVENTORY_SERVICE_MEMORY_LIMIT=1G

# --- PAYMENT SERVICE (Phase 3) ---
# DB password comes from a Docker secret (see SECRETS section).
PAYMENT_SERVICE_DB_USER=payments_svc
PAYMENT_SERVICE_REPLICAS=2
PAYMENT_SERVICE_MEMORY_LIMIT=1G

# --- GRAPHQL GATEWAY (Phase 2) ---
# No secrets, no DB. Configuration is entirely via env vars set in the
# prod overlay (docker-compose.prod.yml).
#
# Only replicas and memory are set here as defaults.
GRAPHQL_GATEWAY_REPLICAS=2
GRAPHQL_GATEWAY_MEMORY_LIMIT=1G


# ------------------------------------------------------------------------------
# gRPC AND TLS (production)
# ------------------------------------------------------------------------------
# mTLS is always enabled in production. The certificate files must be
# present in /etc/omp/tls/<service>/ on the host before starting the stack.
#
# Setup:
#   sudo mkdir -p /etc/omp/tls
#   cd infrastructure/tls
#   sudo ./generate-ca.sh --output /etc/omp/tls
#   sudo ./generate-service-cert.sh order-service --output /etc/omp/tls
#   sudo ./generate-service-cert.sh inventory-service --output /etc/omp/tls
#   sudo ./generate-service-cert.sh payment-service --output /etc/omp/tls
#
# Then, chown the service certificate directories to match the container's
# uid (1000:1000) so the container process can read them:
#   sudo chown -R 1000:1000 /etc/omp/tls/order-service
#   sudo chown -R 1000:1000 /etc/omp/tls/inventory-service
#   sudo chown -R 1000:1000 /etc/omp/tls/payment-service
#
# The CA certificate can remain root-owned (mode 644) — it's public.
# ------------------------------------------------------------------------------
# gRPC AND TLS
# ------------------------------------------------------------------------------
# Configuration for internal gRPC communication and mTLS.
#
# Most of these have sensible defaults in the services' application.yml.
# They're listed here so you can override them without editing YAML.

# Enable or disable mTLS on internal gRPC calls.
#   - Dev: "true" — mTLS is used (certificates from infrastructure/tls/).
#   - Test: "false" — the test profile disables it for in-process gRPC.
#   - Prod: "true" — always enabled.
GRPC_MTLS_ENABLED=true

# gRPC negotiation type for clients. Values: TLS (mTLS) or PLAINTEXT.
# Overridden to PLAINTEXT in test profile.
GRPC_NEGOTIATION_TYPE=TLS

# Path to the TLS certificate files inside the container.
# Dev: mounted from infrastructure/tls/<service>/.
# Prod: mounted from /etc/omp/tls/<service>/.
TLS_CERT_PATH=/etc/tls/tls.crt
TLS_KEY_PATH=/etc/tls/tls.key
TLS_CA_PATH=/etc/tls/ca.crt


# --- NOTIFICATION SERVICE (Phase 4) ---
# WebSocket + Kafka consumer. No database.
# Uses Redis (see REDIS section above).
# Uses Kafka (see KAFKA section above).
NOTIFICATION_SERVICE_REPLICAS=2
NOTIFICATION_SERVICE_MEMORY_LIMIT=1G

# --- API GATEWAY (Phase 7) ---
# API_GATEWAY_PORT=8000
# API_GATEWAY_RATE_LIMIT_RPS=1000

# ==============================================================================
# SECRETS — READ THIS SECTION CAREFULLY
# ==============================================================================
#
# Docker Compose file-based secrets are mounted from a path on the HOST into
# the container at /run/secrets/<name>. The mount is read-only, owned by root,
# and only readable by the container's user (thanks to the tmpfs backing).
#
# SETUP
#
#   RECOMMENDED: use the automated script
#
#     sudo ./scripts/create-secrets.sh
#
#   It generates all 13 secrets with the correct permissions and refuses
#   to overwrite existing files. See scripts/create-secrets.sh for details.
#
#   MANUAL SETUP (if you prefer to create secrets yourself):
#
#   1. Create the secrets directory:
#        sudo install -d -m 700 -o root -g root /etc/omp/secrets
#
#   2. For each secret, create a file containing ONLY the secret value:
#        sudo install -m 600 -o root -g root /dev/null /etc/omp/secrets/<name>
#        printf '%s' 'your-strong-password' \
#          | sudo tee /etc/omp/secrets/<name> >/dev/null
#      (Use `printf` and avoid a trailing newline — some readers include it
#       and authentication fails.)
#
#   3. Verify permissions:
#        sudo ls -l /etc/omp/secrets/
#      Every file should be `-rw------- root root`.
#
#   4. The complete list of secrets the compose file expects:
#
#      PLATFORM INFRASTRUCTURE:
#        /etc/omp/secrets/postgres_superuser_password
#        /etc/omp/secrets/postgres_app_password
#        /etc/omp/secrets/redis_password
#        /etc/omp/secrets/redis_sentinel_password
#        /etc/omp/secrets/keycloak_admin_password
#        /etc/omp/secrets/grafana_admin_password
#        /etc/omp/secrets/kafka_broker_password
#        /etc/omp/secrets/pgbackrest_repo_cipher
#
#      PER-SERVICE DATABASE PASSWORDS:
#        /etc/omp/secrets/products_svc_password
#        /etc/omp/secrets/customers_svc_password
#        /etc/omp/secrets/orders_svc_password
#        /etc/omp/secrets/inventory_svc_password
#        /etc/omp/secrets/payments_svc_password
#
#   5. Update .env.prod to point at the correct paths IF they differ from
#      the defaults in docker-compose.prod.yml.

#
# GENERATING STRONG VALUES
#   openssl rand -base64 32       # 32 random bytes, base64 → ~44 chars
#   openssl rand -hex 32          # 64 hex chars
#   pwgen -s 32 1                 # if pwgen installed
#
# DO NOT
#   - Do not put secret values in .env.prod.
#   - Do not commit the secret files to git.
#   - Do not put them on a shared filesystem (NFS, SMB) without encryption.
#   - Do not reuse the same value across environments (prod/staging/dev).
#   - Do not include trailing whitespace — some readers treat it as part of
#     the secret, which causes authentication failures that are hard to debug.
#
# ROTATION
#   Updating a secret file does NOT update a running container's view of it
#   until the container is restarted. To rotate:
#     1. Update the file.
#     2. Restart the affected services:
#          docker compose ... up -d --force-recreate <service>
#     3. Verify the new value works (healthcheck passes).
#     4. Delete any old value from backups of the secret store.
#
#   Full rotation policy and per-secret runbook are in docs/runbooks/.
#
# # ==============================================================================
# VERIFICATION CHECKLIST (after setup)
# ==============================================================================
#   [ ] .env.prod exists, mode 600, owned by deploy user
#   [ ] .env.prod contains NO secret values (grep for known passwords)
#   [ ] /etc/omp/secrets/ exists, mode 700, owner root
#   [ ] All 13 secret files present in /etc/omp/secrets/:
#         Platform infrastructure (8):
#           postgres_superuser_password
#           postgres_app_password
#           redis_password
#           redis_sentinel_password
#           keycloak_admin_password
#           grafana_admin_password
#           kafka_broker_password
#           pgbackrest_repo_cipher
#         Per-service DB passwords (5):
#           products_svc_password
#           customers_svc_password
#           orders_svc_password
#           inventory_svc_password
#           payments_svc_password
#     Verify with:
#         sudo ls -l /etc/omp/secrets/ | wc -l
#     Expected: at least 13 lines (13 files + the total line).
#   [ ] Every secret file is mode 600, owned by root
#   [ ] pgBackRest repo cipher is saved in a password manager (NOT only on
#       this host — losing it makes all backups unreadable)
#   [ ] OMP_DOMAIN resolves publicly to this host's IP
#   [ ] Wildcard subdomains resolve publicly to this host's IP
#   [ ] Ports 80 and 443 are reachable from the internet
#   [ ] TRAEFIK_ADMIN_BASICAUTH is a valid bcrypt hash (test with `htpasswd -vb`)
#   [ ] `docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#         --env-file .env.prod config` exits 0 with no warnings
#   [ ] In the resolved output, verify:
#         * `PROMETHEUS_ENV: prod` (not `dev`)
#         * `TRAEFIK_ADMIN_BASICAUTH` is intact (contains `$2y$`, not `y...`)
#         * No `${...}` placeholders remain (everything resolved)
#         * Every service block that references a secret shows a path under
#           `/run/secrets/` (Docker mounts it as a file, not an env var)
#
# ==============================================================================
#
# ==============================================================================
# FINAL REMINDER
# ==============================================================================
# If you are reading this at 2 AM because something is on fire and you're
# tempted to put a password directly in .env.prod "just this once to unblock":
# don't. It will stay there. It will get committed. It will end up in a post-
# mortem. Put it in /etc/omp/secrets/ like the checklist says. The 45 seconds
# you save now are the incident review you'll attend later.
# ==============================================================================