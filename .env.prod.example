# Non-secret production configuration. Runtime values come from managed mounted files.
# Compose: standalone production manifest + verified immutable release overlay.
COMPOSE_PROJECT_NAME=omp
OMP_DOMAIN=example.invalid
ACME_EMAIL=ops@example.invalid
POSTGRES_DB=omp
POSTGRES_SUPERUSER=omp_admin
PROMETHEUS_ENV=prod
TRACING_SAMPLE_RATE=1.0
# Required host paths. Generate route and receiver configs with the scripts in the release runbook.
INGRESS_ROUTES_FILE=/etc/omp/config/ingress-routes.json
ALERTMANAGER_CONFIG_FILE=/etc/omp/config/alertmanager.json
OMP_BACKUP_REPOSITORY=/mnt/omp-backups
# Certificates/public trust and banking credentials remain separate directory projections.
BANK_LEDGER_SECRETS_DIR=/etc/omp/secrets/bank-ledger
BANK_ADAPTER_SECRETS_DIR=/etc/omp/secrets/bank-adapter
BANK_TRUST_DIRECTORY=/etc/omp/trust/bank
OMP_TLS_DIRECTORY=/etc/omp/tls
OMP_SECRETS_DIRECTORY=/etc/omp/secrets
METRICS_TOKEN_DIRECTORY=/run/omp-metrics-token
# Additional /etc/omp/secrets files and ownership are listed in docs/runbooks/release.md.
# Never add API keys, passwords, bearer tokens, signing keys or credential values here.
